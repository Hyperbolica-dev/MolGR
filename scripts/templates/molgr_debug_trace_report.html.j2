<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MolGR Debug Trace Report</title>
  <style>
    :root { color-scheme: light; }
    body { font-family: "Iosevka", "Consolas", monospace; margin: 0; background: linear-gradient(180deg, #f8fafc, #eef2f7); color: #1f2937; }
    main { max-width: 1200px; margin: 0 auto; padding: 20px; }
    h1 { margin: 0 0 12px; }
    .meta { margin: 0 0 16px; padding: 10px 12px; border: 1px solid #cbd5e1; background: #ffffff; border-radius: 8px; }
    .note { margin: 0 0 16px; padding: 10px 12px; border: 1px solid #f59e0b; background: #fffbeb; border-radius: 8px; }
    .molgr-layout { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 16px; align-items: start; }
    .molgr-tree { position: sticky; top: 20px; height: calc(100vh - 40px); min-width: 0; overflow: hidden; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
    .molgr-details { min-width: 0; display: grid; gap: 12px; }
    .graph-canvas-wrap { width: 100%; max-width: 100%; min-width: 0; min-height: 0; flex: 1 1 auto; border: 1px solid #dbe4ef; border-radius: 8px; background: #f8fafc; overflow: hidden; display: flex; }
    #molgr-canvas { display: block; width: 100%; height: 100%; flex: 1 1 auto; }
    .search-box { margin: 0 0 12px; display: grid; gap: 6px; }
    .search-box label { font-weight: 700; color: #334155; }
    .search-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .search-input { width: 100%; padding: 8px 10px; border: 1px solid #94a3b8; border-radius: 6px; font: inherit; background: #fff; color: #0f172a; }
    .candidate-panel { border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 8px; padding: 8px 10px; }
    .candidate-panel summary { cursor: pointer; font-weight: 800; color: #1e3a8a; }
    .candidate-panel[open] summary { margin-bottom: 6px; }
    .candidate-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; max-height: 180px; overflow: auto; }
    .candidate-item { padding: 4px 6px; border-radius: 6px; border: 1px solid #bfdbfe; background: #fff; color: #0f172a; font-size: 12px; }
    .candidate-item.is-selected { border-color: #f59e0b; background: #fef3c7; box-shadow: inset 0 0 0 1px #fbbf24; }
    .candidate-empty { margin: 0; color: #1e3a8a; font-size: 12px; }
    .failures-panel { border: 1px solid #fecaca; background: #fff7ed; border-radius: 8px; padding: 8px 10px; }
    .failures-panel summary { cursor: pointer; font-weight: 800; color: #7f1d1d; }
    .failures-panel[open] summary { margin-bottom: 6px; }
    .failures-panel .hint { margin: 0 0 8px; color: #7f1d1d; font-size: 12px; }
    .failures-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; max-height: 180px; overflow: auto; }
    .failures-list a { display: block; padding: 4px 6px; border-radius: 6px; text-decoration: none; color: #111827; background: #fff; border: 1px solid #fed7aa; }
    .failures-list a:hover, .failures-list a:focus-visible { background: #ffedd5; outline: none; }
    .failures-empty { margin: 0; color: #7f1d1d; font-size: 12px; }
    .tree-list { margin: 0; padding: 0; list-style: none; }
    .tree-list .tree-list { margin-top: 6px; padding-left: 14px; border-left: 1px solid #e2e8f0; }
    .tree-link { display: block; padding: 5px 6px; border-radius: 6px; color: #0f172a; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tree-link:hover, .tree-link:focus-visible { background: #e2e8f0; outline: none; }
    .tree-link.is-active { background: #dbeafe; box-shadow: inset 0 0 0 1px #93c5fd; }
    .tree-link.is-chain { background: #fef3c7; box-shadow: inset 0 0 0 1px #f59e0b; }
    .tree-list.tree-list-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(100%); white-space: nowrap; }
    .detail { border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; padding: 12px; scroll-margin-top: 24px; }
    .detail.is-focused { border-color: #2563eb; box-shadow: 0 0 0 2px #bfdbfe; }
    .detail.is-chain { border-color: #f59e0b; box-shadow: 0 0 0 2px #fde68a; }
    .detail h3 { margin: 0 0 10px; font-size: 15px; overflow-wrap: anywhere; word-break: break-word; }
    .fields { display: grid; grid-template-columns: repeat(6, minmax(90px, auto)); gap: 4px 8px; margin: 8px 0 12px; }
    .fields dt { font-weight: 700; color: #334155; overflow-wrap: anywhere; word-break: break-word; }
    .fields dd { margin: 0; color: #0f172a; min-width: 0; overflow-wrap: anywhere; word-break: break-word; }
    .smiles-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
    .smiles { min-width: 0; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px; background: #f8fafc; }
    .smiles h4 { margin: 0 0 8px; }
    .mol-svg { max-width: 100%; min-width: 0; overflow-x: auto; }
    .mol-svg svg { display: block; width: 100%; max-width: 100%; height: auto; }
    .smiles-text { margin: 0; max-width: 100%; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
    .delta-table { border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px; background: #f8fafc; }
    .delta-table h4 { margin: 0 0 8px; }
    .delta-table-grid { width: 100%; border-collapse: collapse; font-size: 12px; }
    .delta-table-grid th, .delta-table-grid td { padding: 4px 6px; border-bottom: 1px solid #e2e8f0; text-align: left; vertical-align: top; }
    .delta-table-grid th { color: #334155; font-weight: 800; }
    .delta-table-grid td:last-child { font-family: "Iosevka", "Consolas", monospace; }
    .cycle { color: #b91c1c; padding: 6px 10px; }
    @media (max-width: 900px) {
      .molgr-layout { grid-template-columns: 1fr; }
      .molgr-tree { position: static; height: 70vh; }
    }
    @media (max-width: 760px) {
      main { padding: 14px; }
      .detail { padding: 10px; }
      .fields { grid-template-columns: max-content minmax(0, 1fr); gap: 6px 10px; }
      .smiles-row { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .detail h3 { font-size: 14px; }
    }
  </style>
</head>
<body>
  <main>
    <h1>MolGR Debug Trace Report</h1>
    <div class="meta">Rendered events: {{ rendered_events }} / {{ valid_events }}; malformed lines skipped: {{ malformed_lines }}.</div>
    {{ note_html | safe }}
    {{ orphan_note_html | safe }}
    <div class="molgr-layout">
      <aside id="molgr-tree" class="molgr-tree">
        <details id="molgr-candidate-panel" class="candidate-panel" hidden>
          <summary id="molgr-candidate-title">Candidate pool</summary>
          <p id="molgr-candidate-empty" class="candidate-empty" hidden>No candidates</p>
          <ul id="molgr-candidate-list" class="candidate-list"></ul>
        </details>
        <div class="search-box">
          <div class="search-controls">
            <span><input id="toggle-noops" type="checkbox" checked> <label for="toggle-noops">Hide no-ops</label></span>
            <span><input id="toggle-only-changed" type="checkbox"> <label for="toggle-only-changed">Only changed</label></span>
            <span><input id="toggle-only-anomalies" type="checkbox"> <label for="toggle-only-anomalies">Only anomalies</label></span>
          </div>
          <label for="event-search">Filter tree events</label>
          <input id="event-search" class="search-input" type="search" placeholder="Search op/smiles/status/event id...">
        </div>
        <details id="molgr-failures" class="failures-panel" hidden>
          <summary id="molgr-failures-title">Failures</summary>
          <p class="hint">Hotkeys: next = <b>N</b>, prev = <b>P</b></p>
          <p id="molgr-failures-empty" class="failures-empty" hidden>No failures in visible events.</p>
          <ul id="molgr-failures-list" class="failures-list"></ul>
        </details>
        <div class="graph-canvas-wrap">
          <canvas id="molgr-canvas" aria-label="MolGR event graph" role="img"></canvas>
        </div>
        <ul class="tree-list tree-list-hidden">
          {{ tree_html | safe }}
        </ul>
      </aside>
      <section id="molgr-details" class="molgr-details">
        {{ detail_html | safe }}
      </section>
    </div>
  </main>
  <script id="molgr-candidate-pool" type="application/json">{{ candidate_pool_json | safe }}</script>
  <script id="molgr-graph-model" type="application/json">{{ graph_model_json | safe }}</script>
  <script>
    (() => {
      const candidatePoolElement = document.getElementById("molgr-candidate-pool");
      let candidatePool = [];
      if (candidatePoolElement && candidatePoolElement.textContent) {
        try {
          const parsed = JSON.parse(candidatePoolElement.textContent);
          if (Array.isArray(parsed)) {
            candidatePool = parsed;
          } else if (parsed && typeof parsed === "object" && Array.isArray(parsed.candidates)) {
            candidatePool = parsed.candidates;
          }
        } catch (_err) {
          candidatePool = [];
        }
      }

      const graphModelElement = document.getElementById("molgr-graph-model");
      let graphModel = { nodes: [], edges: [] };
      if (graphModelElement && graphModelElement.textContent) {
        try {
          const parsed = JSON.parse(graphModelElement.textContent);
          if (parsed && typeof parsed === "object") {
            graphModel = parsed;
          }
        } catch (_err) {
          graphModel = { nodes: [], edges: [] };
        }
      }
      window.molgrGraphModel = graphModel;

      const tree = document.getElementById("molgr-tree");
      const details = document.getElementById("molgr-details");
      const searchInput = document.getElementById("event-search");
      const toggleNoops = document.getElementById("toggle-noops");
      const toggleOnlyChanged = document.getElementById("toggle-only-changed");
      const toggleOnlyAnomalies = document.getElementById("toggle-only-anomalies");
      const graphCanvas = document.getElementById("molgr-canvas");
      const candidatePanel = document.getElementById("molgr-candidate-panel");
      const candidateTitle = document.getElementById("molgr-candidate-title");
      const candidateList = document.getElementById("molgr-candidate-list");
      const candidateEmpty = document.getElementById("molgr-candidate-empty");
      const failuresPanel = document.getElementById("molgr-failures");
      const failuresTitle = document.getElementById("molgr-failures-title");
      const failuresList = document.getElementById("molgr-failures-list");
      const failuresEmpty = document.getElementById("molgr-failures-empty");

      if (!(tree instanceof HTMLElement) || !(details instanceof HTMLElement) || !(searchInput instanceof HTMLInputElement) || !(toggleNoops instanceof HTMLInputElement) || !(toggleOnlyChanged instanceof HTMLInputElement) || !(toggleOnlyAnomalies instanceof HTMLInputElement) || !(graphCanvas instanceof HTMLCanvasElement)) {
        return;
      }

      const graphContext = graphCanvas.getContext("2d");
      if (!graphContext) {
        return;
      }

      const detailById = new Map();
      for (const detail of details.querySelectorAll(".detail[data-node-id]")) {
        const nodeId = detail.getAttribute("data-node-id");
        if (nodeId) {
          detailById.set(nodeId, detail);
        }
      }

      const records = new Map();
      for (const link of tree.querySelectorAll(".tree-link[data-node-id]")) {
        const nodeId = link.getAttribute("data-node-id");
        if (!nodeId) {
          continue;
        }
        const item = link.closest("li.tree-item");
        const parentItem = item ? item.parentElement?.closest("li.tree-item") : null;
        const parentId = parentItem ? parentItem.getAttribute("data-node-id") : null;
        records.set(nodeId, {
          id: nodeId,
          link,
          detail: detailById.get(nodeId) ?? null,
          parentId,
          baseVisible: true,
        });
      }

      const modelNodes = Array.isArray(graphModel.nodes) ? graphModel.nodes : [];
      const nodeOrder = new Map();
      modelNodes.forEach((node, idx) => {
        if (!node || typeof node !== "object") {
          return;
        }
        const rawId = node.id;
        if (typeof rawId !== "number") {
          return;
        }
        if (!nodeOrder.has(rawId)) {
          nodeOrder.set(rawId, idx);
        }
      });

      const sortedGraphNodes = modelNodes
        .filter((node) => node && typeof node === "object" && typeof node.id === "number")
        .slice()
        .sort((a, b) => {
          if (a.id !== b.id) {
            return a.id - b.id;
          }
          return (nodeOrder.get(a.id) ?? 0) - (nodeOrder.get(b.id) ?? 0);
        });

      const parentById = new Map();
      for (const node of sortedGraphNodes) {
        const parentId = typeof node.parent_id === "number" ? node.parent_id : null;
        parentById.set(node.id, parentId);
      }

      const depthById = new Map();
      const computeDepth = (nodeId) => {
        if (depthById.has(nodeId)) {
          return depthById.get(nodeId) || 0;
        }
        const visited = new Set();
        let depth = 0;
        let currentId = nodeId;
        while (parentById.has(currentId)) {
          const parentId = parentById.get(currentId);
          if (typeof parentId !== "number" || !parentById.has(parentId) || visited.has(parentId)) {
            break;
          }
          visited.add(parentId);
          depth += 1;
          currentId = parentId;
        }
        depthById.set(nodeId, depth);
        return depth;
      };

      const graphBoxById = new Map();
      let activeNodeId = null;
      let clearFocusTimer = null;
      const MIN_SCALE = 0.2;
      const MAX_SCALE = 8;
      const WORLD_MARGIN = 36;
      let viewScale = 1;
      let viewOffsetX = 0;
      let viewOffsetY = 0;
      let viewInitialized = false;
      let isPanning = false;
      let panStartPointer = null;
      let panStartOffset = null;

      const clamp = (value, minValue, maxValue) => Math.max(minValue, Math.min(maxValue, value));

      const worldToScreen = (point) => ({
        x: point.x * viewScale + viewOffsetX,
        y: point.y * viewScale + viewOffsetY,
      });

      const screenToWorld = (point) => ({
        x: (point.x - viewOffsetX) / viewScale,
        y: (point.y - viewOffsetY) / viewScale,
      });

      const fitGraphToViewport = (bounds, width, height) => {
        const spanX = Math.max(bounds.maxX - bounds.minX, 1);
        const spanY = Math.max(bounds.maxY - bounds.minY, 1);
        const scaleX = Math.max(width - WORLD_MARGIN * 2, 1) / spanX;
        const scaleY = Math.max(height - WORLD_MARGIN * 2, 1) / spanY;
        viewScale = clamp(Math.min(scaleX, scaleY), MIN_SCALE, MAX_SCALE);

        const centerWorldX = (bounds.minX + bounds.maxX) / 2;
        const centerWorldY = (bounds.minY + bounds.maxY) / 2;
        viewOffsetX = width / 2 - centerWorldX * viewScale;
        viewOffsetY = height / 2 - centerWorldY * viewScale;
        viewInitialized = true;
      };

      const focusDetail = (nodeId) => {
        const rec = records.get(String(nodeId));
        if (!rec || !rec.detail) {
          return;
        }
        rec.detail.scrollIntoView({ behavior: "smooth", block: "start" });
        rec.detail.classList.add("is-focused");
        if (clearFocusTimer !== null) {
          window.clearTimeout(clearFocusTimer);
        }
        clearFocusTimer = window.setTimeout(() => {
          rec.detail.classList.remove("is-focused");
        }, 1400);
      };

      let activeTreeId = null;
      let activeChainIds = new Set();
      let activeCandidateId = null;

      const syncSelectedCandidateRow = () => {
        if (!(candidateList instanceof HTMLElement)) {
          return;
        }
        for (const item of candidateList.querySelectorAll(".candidate-item")) {
          const itemNodeId = item.getAttribute("data-candidate-node-id");
          item.classList.toggle("is-selected", activeCandidateId !== null && itemNodeId === activeCandidateId);
        }
      };

      const clearChainHighlight = () => {
        for (const id of activeChainIds) {
          const rec = records.get(String(id));
          if (!rec) {
            continue;
          }
          rec.link.classList.remove("is-chain");
          if (rec.detail) {
            rec.detail.classList.remove("is-chain");
          }
        }
        activeChainIds.clear();
        activeCandidateId = null;
        syncSelectedCandidateRow();
      };

      const setChainHighlight = (nodeId) => {
        clearChainHighlight();
        if (typeof nodeId !== "number") {
          return;
        }
        activeCandidateId = String(nodeId);
        const visited = new Set();
        let currentId = nodeId;
        while (typeof currentId === "number" && !visited.has(currentId)) {
          visited.add(currentId);
          activeChainIds.add(currentId);
          const rec = records.get(String(currentId));
          if (rec) {
            rec.link.classList.add("is-chain");
            if (rec.detail) {
              rec.detail.classList.add("is-chain");
            }
          }
          const parentId = parentById.get(currentId);
          if (typeof parentId !== "number") {
            break;
          }
          currentId = parentId;
        }
        syncSelectedCandidateRow();
      };

      const setActiveTreeLink = (nodeId) => {
        const nextId = nodeId === null || nodeId === undefined ? null : String(nodeId);
        if (activeTreeId === nextId) {
          return;
        }
        if (activeTreeId !== null) {
          const prev = records.get(activeTreeId);
          if (prev && prev.link) {
            prev.link.classList.remove("is-active");
          }
        }
        activeTreeId = nextId;
        if (activeTreeId !== null) {
          const rec = records.get(activeTreeId);
          if (rec && rec.link) {
            rec.link.classList.add("is-active");
          }
        }
      };

      const focusNode = (nodeId, options = {}) => {
        const idText = nodeId === null || nodeId === undefined ? null : String(nodeId);
        const rec = idText ? records.get(idText) : null;
        if (rec && rec.link) {
          rec.link.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        setActiveTreeLink(idText);
        activeNodeId = typeof nodeId === "number" ? nodeId : activeNodeId;
        drawGraph({ forceFit: options.forceFit === true });
        if (idText) {
          focusDetail(idText);
        }
      };

      let cachedFailureIds = [];
      let failureIndex = -1;

      const collectFailures = () => {
        const out = [];
        for (const rec of records.values()) {
          if (rec.link.getAttribute("data-is-failure") !== "1") {
            continue;
          }
          if (rec.link.hidden) {
            continue;
          }
          out.push(rec.id);
        }
        return out;
      };

      const renderFailuresPanel = () => {
        if (!(failuresPanel instanceof HTMLElement) || !(failuresTitle instanceof HTMLElement) || !(failuresList instanceof HTMLElement) || !(failuresEmpty instanceof HTMLElement)) {
          return;
        }
        cachedFailureIds = collectFailures();
        failureIndex = -1;

        const totalFailures = (() => {
          let count = 0;
          for (const rec of records.values()) {
            if (rec.link.getAttribute("data-is-failure") === "1") {
              count += 1;
            }
          }
          return count;
        })();

        if (totalFailures === 0) {
          failuresPanel.hidden = true;
          return;
        }

        failuresPanel.hidden = false;
        failuresTitle.textContent = `Failures (${cachedFailureIds.length}/${totalFailures} visible)`;
        failuresList.innerHTML = "";
        if (!cachedFailureIds.length) {
          failuresEmpty.hidden = false;
          return;
        }
        failuresEmpty.hidden = true;

        for (const id of cachedFailureIds) {
          const rec = records.get(String(id));
          const label = (rec && rec.link && rec.link.textContent) ? rec.link.textContent.trim() : `#${id}`;
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#event-${id}`;
          a.textContent = label;
          a.addEventListener("click", (event) => {
            event.preventDefault();
            focusNode(id);
          });
          li.appendChild(a);
          failuresList.appendChild(li);
        }
      };

      const focusFailureByIndex = (nextIndex) => {
        if (!cachedFailureIds.length) {
          return;
        }
        const len = cachedFailureIds.length;
        const idx = ((nextIndex % len) + len) % len;
        failureIndex = idx;
        focusNode(cachedFailureIds[idx]);
      };

      const nextFailure = () => focusFailureByIndex(failureIndex + 1);
      const prevFailure = () => focusFailureByIndex(failureIndex - 1);

      const renderCandidatePanel = () => {
        if (!(candidatePanel instanceof HTMLElement) || !(candidateTitle instanceof HTMLElement) || !(candidateList instanceof HTMLElement) || !(candidateEmpty instanceof HTMLElement)) {
          return;
        }
        candidateList.innerHTML = "";
        const candidates = Array.isArray(candidatePool) ? candidatePool : [];
        if (!candidates.length) {
          candidatePanel.hidden = false;
          candidateEmpty.hidden = false;
          candidateTitle.textContent = "Candidate pool (0)";
          return;
        }

        candidatePanel.hidden = false;
        candidateEmpty.hidden = true;
        candidateTitle.textContent = `Candidate pool (${candidates.length})`;

        for (const candidate of candidates) {
          if (!candidate || typeof candidate !== "object") {
            continue;
          }
          const nodeIdValue = candidate.node_id ?? candidate.nodeId ?? candidate.id;
          const nodeId = nodeIdValue === null || nodeIdValue === undefined ? "" : String(nodeIdValue);
          const smiles = typeof candidate.smiles === "string" && candidate.smiles.trim() ? candidate.smiles.trim() : "(no smiles)";
          const score = typeof candidate.score === "number" ? candidate.score.toFixed(4) : (candidate.score ?? "n/a");

          const li = document.createElement("li");
          li.className = "candidate-item";
          li.setAttribute("data-candidate-node-id", nodeId);
          li.textContent = `${score} #${nodeId} ${smiles}`;
          if (activeCandidateId !== null && nodeId === activeCandidateId) {
            li.classList.add("is-selected");
          }

          if (/^-?\d+$/.test(nodeId)) {
            const numericId = Number(nodeId);
            li.addEventListener("click", () => {
              setChainHighlight(numericId);
              focusNode(numericId);
            });
          }

          candidateList.appendChild(li);
        }

        if (!candidateList.childElementCount) {
          candidateEmpty.hidden = false;
        }
      };

      const isTypingTarget = (target) => {
        if (!(target instanceof Element)) {
          return false;
        }
        const tag = target.tagName ? target.tagName.toLowerCase() : "";
        if (tag === "input" || tag === "textarea") {
          return true;
        }
        return Boolean(target.closest("input, textarea"));
      };

      window.addEventListener("keydown", (event) => {
        if (event.defaultPrevented) {
          return;
        }
        if (event.ctrlKey || event.metaKey || event.altKey) {
          return;
        }
        if (isTypingTarget(event.target)) {
          return;
        }
        const key = String(event.key || "").toLowerCase();
        if (key === "n") {
          event.preventDefault();
          nextFailure();
        } else if (key === "p") {
          event.preventDefault();
          prevFailure();
        }
      });

      const drawGraph = (options = {}) => {
        const forceFit = options && options.forceFit === true;
        const width = Math.max(Math.floor(graphCanvas.clientWidth), 1);
        const height = Math.max(Math.floor(graphCanvas.clientHeight), 1);
        const dpr = window.devicePixelRatio || 1;
        graphCanvas.width = Math.floor(width * dpr);
        graphCanvas.height = Math.floor(height * dpr);
        graphContext.setTransform(dpr, 0, 0, dpr, 0, 0);
        graphContext.clearRect(0, 0, width, height);

        const visibleNodes = sortedGraphNodes.filter((node) => {
          const rec = records.get(String(node.id));
          return rec && !rec.link.hidden;
        });
        if (!visibleNodes.length) {
          graphBoxById.clear();
          graphContext.fillStyle = "#64748b";
          graphContext.font = '13px "Iosevka", "Consolas", monospace';
          graphContext.fillText("No events match current filters.", 12, 20);
          return;
        }

        const depthGroups = new Map();
        let maxDepth = 0;
        for (const node of visibleNodes) {
          const depth = computeDepth(node.id);
          if (!depthGroups.has(depth)) {
            depthGroups.set(depth, []);
          }
          depthGroups.get(depth).push(node);
          if (depth > maxDepth) {
            maxDepth = depth;
          }
        }

        const laneWidth = 140;
        const radius = 8;
        const levelGap = 52;
        graphBoxById.clear();

        const centerById = new Map();
        let minWorldX = Number.POSITIVE_INFINITY;
        let minWorldY = Number.POSITIVE_INFINITY;
        let maxWorldX = Number.NEGATIVE_INFINITY;
        let maxWorldY = Number.NEGATIVE_INFINITY;
        for (const [depth, group] of depthGroups.entries()) {
          const x = depth * laneWidth;
          for (let idx = 0; idx < group.length; idx += 1) {
            const node = group[idx];
            const y = idx * levelGap;
            centerById.set(node.id, { x, y });
            minWorldX = Math.min(minWorldX, x - radius);
            minWorldY = Math.min(minWorldY, y - radius);
            maxWorldX = Math.max(maxWorldX, x + radius);
            maxWorldY = Math.max(maxWorldY, y + radius);
          }
        }

        if (!Number.isFinite(minWorldX) || !Number.isFinite(minWorldY) || !Number.isFinite(maxWorldX) || !Number.isFinite(maxWorldY)) {
          graphContext.fillStyle = "#64748b";
          graphContext.font = '13px "Iosevka", "Consolas", monospace';
          graphContext.fillText("No events match current filters.", 12, 20);
          return;
        }

        if (!viewInitialized || forceFit) {
          fitGraphToViewport(
            {
              minX: minWorldX,
              minY: minWorldY,
              maxX: maxWorldX,
              maxY: maxWorldY,
            },
            width,
            height,
          );
        }

        const edgeTierStyle = {
          final: { strokeStyle: "#0f766e", lineWidth: 2.8 },
          candidate_success: { strokeStyle: "#059669", lineWidth: 2.0 },
          candidate_failure: { strokeStyle: "#f87171", lineWidth: 1.8 },
          failure: { strokeStyle: "#dc2626", lineWidth: 1.9 },
          success: { strokeStyle: "#2563eb", lineWidth: 1.6 },
          neutral: { strokeStyle: "#94a3b8", lineWidth: 1.25 },
        };

        const nodeTierStyle = {
          final: { fillStyle: "#0f766e", radiusScale: 1.35 },
          candidate_success: { fillStyle: "#059669", radiusScale: 1.12 },
          candidate_failure: { fillStyle: "#f87171", radiusScale: 1.0 },
          failure: { fillStyle: "#dc2626", radiusScale: 1.0 },
          success: { fillStyle: "#2563eb", radiusScale: 1.0 },
          neutral: { fillStyle: "#64748b", radiusScale: 0.9 },
        };

        const scoringCandidateActive = Boolean(graphModel.scoring_candidate_active);

        const nodeTier = (node) => {
          const isFinal = Boolean(node.is_final_used_path);
          const isCandidate = Boolean(node.is_scoring_candidate_path);
          const isFailure = Boolean(node.is_failure);
          const isSuccess = Boolean(node.is_success);
          if (isFinal) {
            return "final";
          }
          if (isCandidate) {
            return "candidate_success";
          }
          if (isFailure) {
            return "failure";
          }
          if (scoringCandidateActive) {
            return "candidate_failure";
          }
          if (isSuccess) {
            return "success";
          }
          return "neutral";
        };

        for (const node of visibleNodes) {
          const source = centerById.get(node.id);
          const parentId = parentById.get(node.id);
          const target = typeof parentId === "number" ? centerById.get(parentId) : null;
          const parentNode = typeof parentId === "number" ? visibleNodes.find((candidate) => candidate.id === parentId) : null;
          if (!source || !target) {
            continue;
          }
          let tier = "neutral";
          if (parentNode && Boolean(parentNode.is_final_used_path) && Boolean(node.is_final_used_path)) {
            tier = "final";
          } else if (parentNode && Boolean(parentNode.is_scoring_candidate_path) && Boolean(node.is_scoring_candidate_path)) {
            tier = "candidate_success";
          } else if (Boolean(node.is_failure)) {
            tier = "failure";
          } else if (scoringCandidateActive) {
            tier = "candidate_failure";
          } else if (Boolean(node.is_success)) {
            tier = "success";
          }
          const style = edgeTierStyle[tier] || edgeTierStyle.neutral;
          graphContext.strokeStyle = style.strokeStyle;
          graphContext.lineWidth = style.lineWidth;
          const sourceScreen = worldToScreen(source);
          const targetScreen = worldToScreen(target);
          graphContext.beginPath();
          graphContext.moveTo(targetScreen.x, targetScreen.y);
          graphContext.lineTo(sourceScreen.x, sourceScreen.y);
          graphContext.stroke();
        }

        for (const node of visibleNodes) {
          const center = centerById.get(node.id);
          if (!center) {
            continue;
          }
          const tier = nodeTier(node);
          const style = nodeTierStyle[tier] || nodeTierStyle.neutral;
          const nodeRadius = radius * style.radiusScale;
          const centerScreen = worldToScreen(center);
          const nodeRadiusScreen = Math.max(nodeRadius * viewScale, 4);
          graphContext.beginPath();
          graphContext.arc(centerScreen.x, centerScreen.y, nodeRadiusScreen, 0, Math.PI * 2);
          graphContext.fillStyle = style.fillStyle;
          graphContext.fill();
          if (Boolean(node.is_final_used_result)) {
            graphContext.beginPath();
            graphContext.arc(centerScreen.x, centerScreen.y, nodeRadiusScreen + 4, 0, Math.PI * 2);
            graphContext.strokeStyle = "#f59e0b";
            graphContext.lineWidth = 2;
            graphContext.stroke();
          }
          graphBoxById.set(node.id, {
            left: centerScreen.x - nodeRadiusScreen - 3,
            top: centerScreen.y - nodeRadiusScreen - 3,
            right: centerScreen.x + nodeRadiusScreen + 3,
            bottom: centerScreen.y + nodeRadiusScreen + 3,
          });
          if (activeNodeId === node.id) {
            graphContext.lineWidth = 2;
            graphContext.strokeStyle = "#111827";
            graphContext.stroke();
          }
        }

        if (activeChainIds.size > 0) {
          graphContext.strokeStyle = "#f59e0b";
          graphContext.lineWidth = 3.2;
          for (const nodeId of activeChainIds) {
            const source = centerById.get(nodeId);
            const parentId = parentById.get(nodeId);
            const target = typeof parentId === "number" && activeChainIds.has(parentId) ? centerById.get(parentId) : null;
            if (!source || !target) {
              continue;
            }
            const sourceScreen = worldToScreen(source);
            const targetScreen = worldToScreen(target);
            graphContext.beginPath();
            graphContext.moveTo(targetScreen.x, targetScreen.y);
            graphContext.lineTo(sourceScreen.x, sourceScreen.y);
            graphContext.stroke();
          }

          graphContext.fillStyle = "#f59e0b";
          for (const nodeId of activeChainIds) {
            const center = centerById.get(nodeId);
            if (!center) {
              continue;
            }
            const centerScreen = worldToScreen(center);
            const nodeRadiusScreen = Math.max(radius * 1.22 * viewScale, 5);
            graphContext.beginPath();
            graphContext.arc(centerScreen.x, centerScreen.y, nodeRadiusScreen, 0, Math.PI * 2);
            graphContext.fill();
          }
        }
      };

      const graphNodeFromPoint = (x, y) => {
        for (const [nodeId, box] of graphBoxById.entries()) {
          if (x >= box.left && x <= box.right && y >= box.top && y <= box.bottom) {
            return nodeId;
          }
        }
        return null;
      };

      graphCanvas.addEventListener("click", (event) => {
        const rect = graphCanvas.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const hitNodeId = graphNodeFromPoint(x, y);
        if (hitNodeId === null) {
          return;
        }
        activeNodeId = hitNodeId;
        drawGraph();
        focusDetail(hitNodeId);
      });

      graphCanvas.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) {
          return;
        }
        isPanning = true;
        panStartPointer = { x: event.clientX, y: event.clientY };
        panStartOffset = { x: viewOffsetX, y: viewOffsetY };
        graphCanvas.setPointerCapture(event.pointerId);
        graphCanvas.style.cursor = "grabbing";
      });

      graphCanvas.addEventListener("pointermove", (event) => {
        if (!isPanning || !panStartPointer || !panStartOffset) {
          return;
        }
        viewOffsetX = panStartOffset.x + (event.clientX - panStartPointer.x);
        viewOffsetY = panStartOffset.y + (event.clientY - panStartPointer.y);
        drawGraph();
      });

      const stopPan = (event) => {
        if (!isPanning) {
          return;
        }
        isPanning = false;
        panStartPointer = null;
        panStartOffset = null;
        graphCanvas.style.cursor = "grab";
        if (event && typeof event.pointerId === "number") {
          try {
            graphCanvas.releasePointerCapture(event.pointerId);
          } catch (_err) {
          }
        }
      };

      graphCanvas.addEventListener("pointerup", stopPan);
      graphCanvas.addEventListener("pointercancel", stopPan);
      graphCanvas.addEventListener("pointerleave", stopPan);
      graphCanvas.style.cursor = "grab";

      graphCanvas.addEventListener("wheel", (event) => {
        event.preventDefault();
        const rect = graphCanvas.getBoundingClientRect();
        const pointer = {
          x: event.clientX - rect.left,
          y: event.clientY - rect.top,
        };
        const worldBefore = screenToWorld(pointer);
        const zoomFactor = Math.exp(-event.deltaY * 0.0015);
        const nextScale = clamp(viewScale * zoomFactor, MIN_SCALE, MAX_SCALE);
        if (nextScale === viewScale) {
          return;
        }
        viewScale = nextScale;
        viewOffsetX = pointer.x - worldBefore.x * viewScale;
        viewOffsetY = pointer.y - worldBefore.y * viewScale;
        drawGraph();
      }, { passive: false });

      window.addEventListener("resize", () => drawGraph({ forceFit: true }));

      const applyBaseVisibility = () => {
        const hideNoops = toggleNoops.checked;
        const onlyChanged = toggleOnlyChanged.checked;
        const onlyAnomalies = toggleOnlyAnomalies.checked;
        const filtersActive = onlyChanged || onlyAnomalies;
        let visibleByFilter = null;
        if (filtersActive) {
          visibleByFilter = new Set();
          for (const rec of records.values()) {
            const changed = rec.link.getAttribute("data-changed") === "1";
            const anomaly = rec.link.getAttribute("data-anomaly") === "1";
            if (onlyChanged && !changed) {
              continue;
            }
            if (onlyAnomalies && !anomaly) {
              continue;
            }
            visibleByFilter.add(rec.id);
            let parentId = rec.parentId;
            while (parentId && records.has(parentId)) {
              visibleByFilter.add(parentId);
              const parent = records.get(parentId);
              parentId = parent ? parent.parentId : null;
            }
          }
        }

        for (const rec of records.values()) {
          const defaultHidden = rec.link.getAttribute("data-default-hidden") === "1";
          if (filtersActive) {
            rec.baseVisible = Boolean(visibleByFilter && visibleByFilter.has(rec.id));
          } else {
            rec.baseVisible = !hideNoops || !defaultHidden;
          }
          if (rec.detail) {
            rec.detail.hidden = !rec.baseVisible;
          }
        }
      };

      const applyTreeSearch = () => {
        const query = searchInput.value.trim().toLowerCase();
        if (query === "") {
          for (const rec of records.values()) {
            rec.link.hidden = !rec.baseVisible;
          }
          return;
        }

        const visibleFromSearch = new Set();
        for (const rec of records.values()) {
          if (!rec.baseVisible) {
            continue;
          }
          const text = (rec.link.getAttribute("data-filter-text") || "").toLowerCase();
          if (!text.includes(query)) {
            continue;
          }
          visibleFromSearch.add(rec.id);
          let parentId = rec.parentId;
          while (parentId && records.has(parentId)) {
            visibleFromSearch.add(parentId);
            const parent = records.get(parentId);
            parentId = parent ? parent.parentId : null;
          }
        }

        for (const rec of records.values()) {
          rec.link.hidden = !rec.baseVisible || !visibleFromSearch.has(rec.id);
        }
      };

      const applyView = () => {
        applyBaseVisibility();
        applyTreeSearch();
        drawGraph({ forceFit: true });
        renderFailuresPanel();
      };

      toggleNoops.addEventListener("change", applyView);
      toggleOnlyChanged.addEventListener("change", applyView);
      toggleOnlyAnomalies.addEventListener("change", applyView);
      searchInput.addEventListener("input", () => {
        applyTreeSearch();
        drawGraph({ forceFit: true });
        renderFailuresPanel();
      });
      renderCandidatePanel();
      applyView();
    })();
  </script>
</body>
</html>
