FROM python:3.10-slim-bookworm

ARG MOLGR_APT_MIRROR=""
ARG MOLGR_PIP_INDEX_URL=""
ARG MOLGR_BUILD_VERSION="0.0.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_INDEX_URL=${MOLGR_PIP_INDEX_URL} \
    MOLGR_PY38_VENV=/opt/molgr-py38 \
    MOLGR_PY310_VENV=/opt/molgr-py310 \
    MOLGR_REVIEW_HOST=0.0.0.0 \
    MOLGR_REVIEW_PORT=8765 \
    MOLGR_REVIEW_ROOT=/workspace \
    MOLGR_REVIEW_DB=/var/lib/molgr-review/review.sqlite \
    MOLGR_REVIEW_FIXTURES_DIR=/workspace/tests/data/reviewed/tmqmg

RUN if [ -n "$MOLGR_APT_MIRROR" ]; then \
        mirror="${MOLGR_APT_MIRROR%/}"; \
        sed -i \
            -e "s|http://deb.debian.org/debian|${mirror}/debian|g" \
            -e "s|http://deb.debian.org/debian-security|${mirror}/debian-security|g" \
            /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        cmake \
        git \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -n "$MOLGR_PIP_INDEX_URL" ]; then \
        pip install --no-cache-dir --index-url "$MOLGR_PIP_INDEX_URL" uv; \
    else \
        pip install --no-cache-dir uv; \
    fi

WORKDIR /workspace
COPY . /workspace

# Build once while creating the image. The entrypoint repeats this install on
# every container start so a bind-mounted checkout always supplies fresh code.
RUN SETUPTOOLS_SCM_PRETEND_VERSION="$MOLGR_BUILD_VERSION" \
    uv pip install --system --no-cache --constraint /workspace/ci/rdkit-constraints.txt -e /workspace 'rdkit-dof>=0.2.1'

# Keep both benchmark runtimes in the image. Python 3.8 is installed through
# uv because Debian Bookworm does not ship that interpreter. Use the latest
# RDKit release supported by each runtime, while Open Babel follows the
# Python-version split.
RUN uv python install 3.8 \
    && py38="$(uv python find 3.8)" \
    && ln -sf "$py38" /usr/local/bin/python3.8 \
    && uv venv --python "$py38" "$MOLGR_PY38_VENV" \
    && uv venv --python python3.10 "$MOLGR_PY310_VENV" \
    && uv pip install --python "$MOLGR_PY38_VENV/bin/python" --no-cache \
        --constraint /workspace/ci/rdkit-constraints.txt \
        "scikit-build-core>=0.11.6" \
        "setuptools-scm>=9.2.2" \
        "pybind11>=3.0.1" \
        "rdkit>=2023.9.6" \
        openbabel-wheel \
        "numpy<2" \
        "pandas>=2.0.3" \
        "rdkit-dof>=0.2.1" \
        tqdm \
    && uv pip install --python "$MOLGR_PY310_VENV/bin/python" --no-cache \
        --constraint /workspace/ci/rdkit-constraints.txt \
        "scikit-build-core>=0.11.6" \
        "setuptools-scm>=9.2.2" \
        "pybind11>=3.0.1" \
        "rdkit>=2023.9.6" \
        "openbabel>=3.2.0" \
        "numpy>=1.26,<2.3" \
        "pandas>=2.0.3" \
        "rdkit-dof>=0.2.1" \
        tqdm \
    && SETUPTOOLS_SCM_PRETEND_VERSION="$MOLGR_BUILD_VERSION" \
       SETUPTOOLS_USE_DISTUTILS=stdlib uv pip install --python "$MOLGR_PY38_VENV/bin/python" \
        --no-build-isolation --no-cache --constraint /workspace/ci/rdkit-constraints.txt -e /workspace \
    && SETUPTOOLS_SCM_PRETEND_VERSION="$MOLGR_BUILD_VERSION" \
       SETUPTOOLS_USE_DISTUTILS=stdlib uv pip install --python "$MOLGR_PY310_VENV/bin/python" \
        --no-build-isolation --no-cache --constraint /workspace/ci/rdkit-constraints.txt -e /workspace

COPY docker/molgr-review-entrypoint.sh /usr/local/bin/molgr-review-entrypoint
RUN mkdir -p /var/lib/molgr-review \
    && chmod +x /usr/local/bin/molgr-review-entrypoint

VOLUME ["/var/lib/molgr-review", "/workspace/tests/data/reviewed/tmqmg"]
EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('MOLGR_REVIEW_PORT', '8765') + '/api/stats', timeout=3)"

ENTRYPOINT ["/usr/local/bin/molgr-review-entrypoint"]
